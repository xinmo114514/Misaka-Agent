{
  "name": "misaka-desktop",
  "version": "0.18.5",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "oxlint src electron",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:electron": "pnpm exec vite build && playwright test --config playwright.electron.config.ts",
    "test:picker": "playwright test --config playwright.picker.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@streamdown/cjk": "1.0.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.477.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.14.2",
    "streamdown": "2.5.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "jsdom": "26.1.0",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "3.2.4"
  }
}
